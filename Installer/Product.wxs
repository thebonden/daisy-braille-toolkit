<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="DAISY-Braille Toolkit"
           Language="1030"
           Version="$(var.ProductVersion)"
           Manufacturer="DAISY-Braille Toolkit"
           UpgradeCode="d2e8b7f2-8f5a-4c6a-9b3d-1a2c3d4e5f60">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"/>
    <MediaTemplate/>

    <Property Id="ARPCONTACT" Value="DAISY-Braille Toolkit" />

    <!-- Installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="DAISY-Braille Toolkit"/>
      </Directory>
    </Directory>

    <!-- The component group will be generated by heat.exe into Installer/HarvestedComponents.wxs -->
    <Feature Id="ProductFeature" Title="DAISY-Braille Toolkit" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
    </Feature>

    <!-- Use a simple WiX UI (Install directory) -->
    <UIRef Id="WixUI_Minimal" />
  </Product>
</Wix>
